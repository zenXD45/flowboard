NODE_ENV=development
PORT=5002
MONGODB_URL=mongodb://127.0.0.1:27017/flowboard
# Comma-separated allowlist of browser origins allowed to call this API, e.g.
# FRONTEND_URL=https://your-app.vercel.app,https://your-app-abc123.vercel.app
# Trailing slashes and capitalisation are ignored. No wildcards: the API sends
# an Authorization header, so a lookalike domain must never be accepted.
FRONTEND_URL=http://localhost:5173
JWT_SECRET=flowboard-dev-only-secret-not-for-prod
JWT_TTL_DAYS=7
REDIS_URL=

# Render's free tier sleeps after ~15 idle minutes. In production the server
# pings its own /health endpoint every 10 minutes to stay warm. Set to "off"
# to disable (useful when you move to a paid instance that never sleeps).
SELF_PING=on
# Milliseconds between pings. Clamped to a 60s minimum. Defaults to 600000.
SELF_PING_INTERVAL_MS=600000

# --- Social sign-in (optional) -------------------------------------------
# Leaving these blank hides the Google/GitHub buttons entirely: the UI asks the
# API which providers are configured rather than assuming. Set only one pair to
# offer a single provider.
#
# PUBLIC_URL must be this server's own public origin, with no trailing slash.
# It is the sole source of the OAuth redirect_uri, so a wrong value produces an
# opaque rejection at the provider. The server refuses to boot in production if
# a provider is configured without it.
PUBLIC_URL=http://localhost:5002
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

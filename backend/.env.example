NODE_ENV=development
PORT=5002
MONGODB_URL=mongodb://127.0.0.1:27017/flowboard
FRONTEND_URL=http://localhost:5173
JWT_SECRET=flowboard-dev-only-secret-not-for-prod
JWT_TTL_DAYS=7
REDIS_URL=

# Render's free tier sleeps after ~15 idle minutes. In production the server
# pings its own /health endpoint every 10 minutes to stay warm. Set to "off"
# to disable (useful when you move to a paid instance that never sleeps).
SELF_PING=on
# Milliseconds between pings. Clamped to a 60s minimum. Defaults to 600000.
SELF_PING_INTERVAL_MS=600000

{
  "name": "flowboard-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FlowBoard API — real-time collaborative Kanban boards with optimistic locking",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "test": "NODE_ENV=test node --test tests/*.test.js",
    "smoke": "NODE_ENV=test node scripts/smoke.js",
    "browser": "node scripts/browser-test.js",
    "verify": "npm run test && npm run smoke && npm run browser"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.0",
    "redis": "^4.7.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "puppeteer-core": "^24.43.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.1.1"
  }
}
